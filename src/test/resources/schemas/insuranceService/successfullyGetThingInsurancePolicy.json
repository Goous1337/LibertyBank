{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "policyInfo": {
      "type": "object",
      "properties": {
        "productId": {
          "type": "integer"
        },
        "productName": {
          "type": "string"
        },
        "startDate": {
          "type": "string"
        },
        "expirationDate": {
          "type": "string"
        },
        "duration": {
          "type": "null"
        },
        "agreementNumber": {
          "type": "string"
        },
        "policyStatus": {
          "type": "string"
        },
        "currencyNumericCode": {
          "type": "integer"
        }
      },
      "required": [
        "productId",
        "productName",
        "startDate",
        "expirationDate",
        "duration",
        "agreementNumber",
        "policyStatus",
        "currencyNumericCode"
      ]
    },
    "insurerInfo": {
      "type": "object",
      "properties": {
        "insurerName": {
          "type": "string"
        },
        "insurerSurname": {
          "type": "string"
        },
        "insurerPatronymic": {
          "type": "string"
        },
        "insurerBirthdate": {
          "type": "string"
        }
      },
      "required": [
        "insurerName",
        "insurerSurname",
        "insurerPatronymic",
        "insurerBirthdate"
      ]
    },
    "concretePolicyDetailsDto": {
      "type": "object",
      "properties": {
        "things": {
          "type": "array",
          "items": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "cost": {
                  "type": "integer"
                }
              },
              "required": [
                "name",
                "type",
                "cost"
              ]
            }
          ]
        },
        "location": {
          "type": "string"
        }
      },
      "required": [
        "things",
        "location"
      ]
    }
  },
  "required": [
    "policyInfo",
    "insurerInfo",
    "concretePolicyDetailsDto"
  ]
}