{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "policyInfo": {
      "type": "object",
      "properties": {
        "productId": {
          "type": "integer"
        },
        "productName": {
          "type": "string"
        },
        "startDate": {
          "type": "string"
        },
        "expirationDate": {
          "type": "string"
        },
        "duration": {
          "type": "integer"
        },
        "agreementNumber": {
          "type": "string"
        },
        "policyStatus": {
          "type": "string"
        },
        "currencyNumericCode": {
          "type": "integer"
        }
      },
      "required": [
        "productId",
        "productName",
        "startDate",
        "expirationDate",
        "duration",
        "agreementNumber",
        "policyStatus",
        "currencyNumericCode"
      ]
    },
    "insurerInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "surname": {
          "type": "string"
        },
        "patronym": {
          "type": "string"
        },
        "birthdate": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "surname",
        "patronym",
        "birthdate"
      ]
    },
    "thingApplication": {
      "type": "object",
      "properties": {
        "location": {
          "type": "string"
        },
        "things": {
          "type": "array",
          "items": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "cost": {
                  "type": "integer"
                }
              },
              "required": [
                "name",
                "type",
                "cost"
              ]
            }
          ]
        }
      },
      "required": [
        "location",
        "things"
      ]
    }
  },
  "required": [
    "policyInfo",
    "insurerInfo",
    "thingApplication"
  ]
}