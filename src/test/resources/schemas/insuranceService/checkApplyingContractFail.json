{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "uri": {
      "type": "string"
    },
    "type": {
      "type": "integer"
    },
    "messages": {
      "type": "array",
      "items": [
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "field",
            "message"
          ]
        }
      ]
    },
    "timestamp": {
      "type": "string"
    }
  },
  "required": [
    "uri",
    "type",
    "messages",
    "timestamp"
  ]
}