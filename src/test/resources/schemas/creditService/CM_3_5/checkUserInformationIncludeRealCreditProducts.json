{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "creditAmount": {
      "type": "number"
    },
    "currencyCode": {
      "type": "string"
    },
    "periodMonths": {
      "type": "integer"
    },
    "interestRate": {
      "type": "number"
    },
    "generalDebt": {
      "type": "number"
    },
    "currPeriodTransaction": {
      "type": "number"
    },
    "percentCreditPayment": {
      "type": "number"
    },
    "paymentDate": {
      "type": "string"
    },
    "outstandingPrincipal": {
      "type": "number"
    },
    "isActive": {
      "type": "boolean"
    },
    "creditAccountNumber": {
      "type": "integer"
    }
  },
  "required": [
    "name",
    "creditAmount",
    "currencyCode",
    "periodMonths",
    "interestRate",
    "generalDebt",
    "currPeriodTransaction",
    "percentCreditPayment",
    "paymentDate",
    "outstandingPrincipal",
    "isActive",
    "creditAccountNumber"
  ]
}