{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "accountInfo": "object",
  "items": {
    "type": "array",
    "properties": {
      "balance": {
        "type": "number"
      },
      "currency": {
        "type": "string"
      },
      "accountType": {
        "type": "string"
      },
      "accountMain": {
        "type": "boolean"
      },
      "accountNumber": {
        "type": "number"
      },
      "status": {
        "type": "string"
      },
      "openDate": {
        "type": "string"
      }
    },
    "required": [
      "balance",
      "currency",
      "accountType",
      "accountMain",
      "accountNumber",
      "status",
      "openDate"
    ]
  }
}