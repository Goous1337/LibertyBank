    },
    "customerId": {
      "type": "string"
    },
    "openDate": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "accountNumber": {
      "type": "string"
    },
    "accountName": {
      "type": "string"
    },
    "balance": {
      "type": "number"
    },
    "status": {
